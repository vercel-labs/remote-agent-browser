{
  "name": "remote-agent-browser",
  "version": "1.0.0",
  "description": "Run agent-browser in a Vercel Sandbox created from a browser-ready container image",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel-labs/remote-agent-browser.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@11.18.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunchee --runtime node",
    "prepublishOnly": "node --run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --run build && node --test tests/*.test.mjs",
    "test:integration": "node --run build && node --test --test-concurrency=1 tests/*.integration.ts",
    "test:unit": "node --run build && node --test tests/unit.test.mjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@vercel/sandbox": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bunchee": "^7.0.0",
    "typescript": "^5.9.0"
  }
}
